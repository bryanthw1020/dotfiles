{
  "$schema": "https://app.kilo.ai/config.json",
  // The installed CLI (kilo 7.8.8, OpenCode V1) rejects the V2 "permissions" and
  // "providers" keys, and its IndexingConfig only accepts the v1 "provider" shape,
  // so those keep their V1 forms until the CLI supports V2.
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.kilocode/skills/*": "allow",
      "~/.agents/skills/*": "allow",
      "~/.local/share/kilo/tool-output/*": "allow",
      // Credentials and keys
      "~/.ssh": "deny",
      "~/.ssh/*": "deny",
      "~/.aws": "deny",
      "~/.aws/*": "deny",
      "~/.kube": "deny",
      "~/.kube/*": "deny",
      "~/.docker": "deny",
      "~/.docker/*": "deny",
      "~/.gnupg": "deny",
      "~/.gnupg/*": "deny",
      "~/.config/gcloud": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.config/gh": "deny",
      "~/.config/gh/*": "deny",
      "~/.config/kilo/secrets": "deny",
      "~/.config/kilo/secrets/*": "deny",
      // Kilo credentials and session data
      "~/.local/share/kilo/auth.json": "deny",
      "~/.local/share/kilo/account.json": "deny",
      "~/.local/share/kilo/mcp-auth.json": "deny",
      "~/.local/share/kilo/kilo.db": "deny",
      "~/.local/share/kilo/kilo.db-*": "deny",
      "~/.local/share/kilo/session-export.db": "deny",
      "~/.local/share/kilo/session-export.db-*": "deny",
      // Keychain, browser, and history
      "~/Library/Keychains": "deny",
      "~/Library/Keychains/*": "deny",
      "~/Library/Application Support/Google/Chrome": "deny",
      "~/Library/Application Support/Google/Chrome/*": "deny",
      "~/Library/Application Support/Firefox": "deny",
      "~/Library/Application Support/Firefox/*": "deny",
      "~/Library/Safari": "deny",
      "~/Library/Safari/*": "deny",
      "~/.mozilla": "deny",
      "~/.mozilla/*": "deny",
      "~/.config/google-chrome": "deny",
      "~/.config/google-chrome/*": "deny",
      "~/.config/chromium": "deny",
      "~/.config/chromium/*": "deny",
      "~/.zsh_history": "deny",
      "~/.bash_history": "deny",
      "~/.local/share/fish/fish_history": "deny",
      "~/.config/atuin": "deny",
      "~/.config/atuin/*": "deny",
      // Broad secrets catch-all stays last
      "*secrets": "deny",
      "*secrets/*": "deny"
    },
    "bash": {
      // Allows first; last match wins, so the denies below override these.
      "pnpm run lint *": "allow",
      "pnpm run typecheck *": "allow",
      "vendor/bin/pint *": "allow",
      "pnpm --filter * run *": "allow",
      "npx eslint *": "allow",
      "php artisan *": "allow",
      "git diff *": "allow",
      "git status *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git log *": "allow",
      "git branch": "allow",
      "git branch --list *": "allow",
      "git branch -a *": "allow",
      "git branch -r *": "allow",
      "git branch -v *": "allow",
      "git show *": "allow",
      "echo *": "allow",
      "pnpm --version *": "allow",
      "pnpm exec vite*": "allow",
      "pnpm exec tsc*": "allow",
      "pnpm exec eslint*": "allow",
      "pnpm exec prettier*": "allow",
      "npm view *": "allow",
      "no-mistakes *": "allow",
      "quota-axi *": "allow",
      "kilo --version": "allow",
      "node --version": "allow",
      "bin/fm-*": "allow",
      "pgrep -fl fm-watch": "allow",
      // Denies last: these override every allow above.
      "sudo *": "deny",
      "chown *": "deny",
      "chmod *": "deny",
      "export *": "deny",
      "npm config *": "deny",
      "npm set *": "deny",
      "pnpm dlx *": "deny",
      "NODE_OPTIONS=* pnpm exec *": "deny",
      // Allowed commands must not become write primitives.
      "*>*": "deny",
      "git *--output*": "deny",
      "git *--ext-diff*": "deny",
      // Built-in defaults allow these readers; block secret reads.
      "cp *.env*": "deny",
      "mv *.env*": "deny",
      "cat *.env*": "deny",
      "head *.env*": "deny",
      "tail *.env*": "deny",
      "less *.env*": "deny",
      "grep *.env*": "deny",
      "rg *.env*": "deny",
      "printenv *": "deny",
      // Mirror the credential paths; head/tail/grep do not trigger external_directory
      "*.ssh/*": "deny",
      "*.ssh": "deny",
      "*.aws/*": "deny",
      "*.aws": "deny",
      "*.kube/*": "deny",
      "*.gnupg/*": "deny",
      "*.docker/config.json": "deny",
      "*.config/gcloud/*": "deny",
      "*.config/gh/*": "deny",
      "*/.local/share/kilo/*": "deny",
      "*secrets*": "deny",
      "*.npmrc*": "deny",
      "*.netrc*": "deny",
      "*.git-credentials*": "deny",
      "*id_rsa*": "deny",
      "*id_ecdsa*": "deny",
      "*id_ed25519*": "deny",
      "*id_dsa*": "deny",
      "*.pem": "deny",
      "*.pem.*": "deny",
      "*.key": "deny",
      "*.key.*": "deny",
      "*Library/Keychains*": "deny",
      "*Application Support/Google/Chrome*": "deny",
      "*Application Support/Firefox*": "deny",
      "*Library/Safari*": "deny",
      "*zsh_history*": "deny",
      "*bash_history*": "deny",
      "*fish_history*": "deny",
      "ssh *": "deny",
      "ssh-add *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "rsync *": "deny",
      "cat *.env.example": "allow"
    },
    "nuxt-ui_get-component": {
      "*": "allow"
    },
    "laravel-boost_application-info": {
      "*": "allow"
    },
    "nuxt_get-deploy-provider": {
      "*": "allow"
    },
    "nuxt_get-documentation-page": {
      "*": "allow"
    },
    "nuxt_list-documentation-pages": {
      "*": "allow"
    },
    "read": {
      "*.env*": "deny",
      "*secrets": "deny",
      "*secrets/*": "deny",
      "*.ssh": "deny",
      "*.ssh/*": "deny",
      "*.aws": "deny",
      "*.aws/*": "deny",
      "*.kube": "deny",
      "*.kube/*": "deny",
      "*.docker": "deny",
      "*.docker/*": "deny",
      "*.gnupg": "deny",
      "*.gnupg/*": "deny",
      "*.config/gcloud": "deny",
      "*.config/gcloud/*": "deny",
      "*.config/gh": "deny",
      "*.config/gh/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.keystore": "deny",
      "*.npmrc": "deny",
      "*.netrc": "deny",
      "*id_rsa": "deny",
      "*id_ed25519": "deny",
      "*id_ecdsa": "deny",
      "*id_dsa": "deny",
      "*Library/Keychains": "deny",
      "*Library/Keychains/*": "deny",
      "*Application Support/Google/Chrome": "deny",
      "*Application Support/Google/Chrome/*": "deny",
      "*Application Support/Firefox": "deny",
      "*Application Support/Firefox/*": "deny",
      "*Library/Safari": "deny",
      "*Library/Safari/*": "deny",
      "*zsh_history": "deny",
      "*bash_history": "deny",
      "*fish_history": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*.env*": "deny",
      "*secrets": "deny",
      "*secrets/*": "deny",
      "*.ssh": "deny",
      "*.ssh/*": "deny",
      "*.aws": "deny",
      "*.aws/*": "deny",
      "*.kube": "deny",
      "*.kube/*": "deny",
      "*.docker": "deny",
      "*.docker/*": "deny",
      "*.gnupg": "deny",
      "*.gnupg/*": "deny",
      "*.config/gcloud": "deny",
      "*.config/gcloud/*": "deny",
      "*.config/gh": "deny",
      "*.config/gh/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.keystore": "deny",
      "*.npmrc": "deny",
      "*.netrc": "deny",
      "*id_rsa": "deny",
      "*id_ed25519": "deny",
      "*id_ecdsa": "deny",
      "*id_dsa": "deny",
      "*Library/Keychains": "deny",
      "*Library/Keychains/*": "deny",
      "*Application Support/Google/Chrome": "deny",
      "*Application Support/Google/Chrome/*": "deny",
      "*Application Support/Firefox": "deny",
      "*Application Support/Firefox/*": "deny",
      "*Library/Safari": "deny",
      "*Library/Safari/*": "deny",
      "*zsh_history": "deny",
      "*bash_history": "deny",
      "*fish_history": "deny",
      "*.git/*": "deny",
      "*dist/*": "deny",
      "*.lock": "deny",
      "pnpm-lock.yaml": "deny",
      "package-lock.json": "deny",
      "yarn.lock": "deny",
      "*.env.example": "allow"
    }
  },
  "sandbox": {
    "enabled": true,
    "network": "allow"
  },
  "indexing": {
    "provider": "kilo",
    "vectorStore": "qdrant",
    "model": "mistralai/mistral-embed-2312",
    "qdrant": {
      "url": "http://localhost:6333",
      "apiKey": "{file:~/.config/kilo/secrets/qdrant-api-key}"
    },
    "enabled": true
  },
  "small_model": "kilo/xiaomi/mimo-v2.6-pro",
  "model": "kilo/deepseek/deepseek-v4.1-flash-1017",
  "agents": {
    "orchestrator": {
      "disabled": true
    }
  },
  "default_agent": "code",
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:~/.config/kilo/secrets/github-pat}",
          "GITHUB_READ_ONLY": "1"
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless"
        ]
      },
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@6.4.0",
          "mcp"
        ],
        "environment": {
          "GHIDRA_INSTALL_DIR": "/opt/homebrew/opt/ghidra/libexec",
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
        }
      }
    }
  },
  "web_search": true,
  "reasoning_display": "preview",
  "remote_control": false,
  "hide_prompt_training_models": true,
  "retention": {
    "enabled": true,
    "maxAgeDays": 30
  }
}