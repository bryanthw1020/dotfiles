{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      // Tightened commands
      "pnpm run lint *": "allow",
      "pnpm run typecheck *": "allow",
      "vendor/bin/pint *": "allow",
      "pnpm --filter *": "allow",
      // Explicit npx and php commands (Replace with your actual tools, e.g., prisma, artisan, pest)
      "npx eslint *": "allow",
      "php artisan *": "allow",
      // Safe Read-only/Informational commands
      "git diff *": "allow",
      "git status *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git show *": "allow",
      "echo *": "allow"
    },
    "nuxt-ui_get-component": {
      "*": "allow"
    },
    "laravel-boost_application-info": {
      "*": "allow"
    },
    "nuxt_get-deploy-provider": {
      "*": "allow"
    },
    "nuxt_get-documentation-page": {
      "*": "allow"
    },
    "nuxt_list-documentation-pages": {
      "*": "allow"
    },
    "read": {
      "**/.env.example": "allow",
      ".env.example": "allow",
      "**/.env*": "deny",
      ".env*": "deny",
      "secrets/**": "deny"
    },
    "edit": {
      "**/.env.example": "allow",
      ".env.example": "allow",
      "**/.env*": "deny",
      ".env*": "deny",
      "secrets/**": "deny",
      "dist/**": "deny",
      "*.lock": "deny"
    },
    "*": "ask"
  },
  "indexing": {
    "provider": "kilo",
    "vectorStore": "qdrant",
    "model": "mistralai/mistral-embed-2312",
    "qdrant": {
      "url": "http://localhost:6333",
      "apiKey": "{file:~/.config/kilo/secrets/qdrant-api-key}"
    },
    "enabled": true
  },
  "small_model": "kilo/deepseek/deepseek-v4.1-flash",
  "model": "kilo/deepseek/deepseek-v4.1-flash",
  "agent": {
    "orchestrator": {
      "disable": true
    },
    "plan": {
      "disable": false
    }
  },
  "default_agent": "code",
  "provider": {},
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:~/.config/kilo/secrets/github-pat}",
        "GITHUB_READ_ONLY": "1"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "environment": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "{file:~/.config/kilo/secrets/playwright-token}"
      }
    },
    "rea": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "rea-agents@6.4.0",
        "mcp"
      ],
      "environment": {
        "GHIDRA_INSTALL_DIR": "/opt/homebrew/opt/ghidra/libexec",
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
      },
      "enabled": true
    }
  },
  "disabled_providers": [],
  "web_search": true,
  "auto_collapse_reasoning": true,
  "remote_control": false,
  "hide_prompt_training_models": true,
  "retention": {
    "enabled": true
  },
}