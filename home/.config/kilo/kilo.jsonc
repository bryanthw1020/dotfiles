{
  "$schema": "https://app.kilo.ai/config.json",
  // The installed CLI (kilo 7.8.8, OpenCode V1) rejects the V2 "permissions" and
  // "providers" keys, and its IndexingConfig only accepts the v1 "provider" shape,
  // so those keep their V1 forms until the CLI supports V2.
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/.kilocode/skills/*": "allow",
      "~/.agents/skills/*": "allow",
      "~/.local/share/kilo/tool-output/*": "allow",
      "*secrets": "deny",
      "*secrets/*": "deny"
    },
    "bash": {
      // Allows first; last match wins, so the denies below override these.
      "pnpm run lint *": "allow",
      "pnpm run typecheck *": "allow",
      "vendor/bin/pint *": "allow",
      "pnpm --filter * run *": "allow",
      "npx eslint *": "allow",
      "php artisan *": "allow",
      "git diff *": "allow",
      "git status *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git log *": "allow",
      "git branch": "allow",
      "git branch --list *": "allow",
      "git branch -a *": "allow",
      "git branch -r *": "allow",
      "git branch -v *": "allow",
      "git show *": "allow",
      "echo *": "allow",
      "pnpm --version *": "allow",
      "pnpm exec vite*": "allow",
      "pnpm exec tsc*": "allow",
      "pnpm exec eslint*": "allow",
      "pnpm exec prettier*": "allow",
      "npm view *": "allow",
      "no-mistakes *": "allow",
      "quota-axi *": "allow",
      "kilo --version": "allow",
      "node --version": "allow",
      "bin/fm-*": "allow",
      "pgrep -fl fm-watch": "allow",
      // Denies last: these override every allow above.
      "sudo *": "deny",
      "chown *": "deny",
      "chmod *": "deny",
      "export *": "deny",
      "npm config *": "deny",
      "npm set *": "deny",
      "pnpm dlx *": "deny",
      "NODE_OPTIONS=* pnpm exec *": "deny",
      // Allowed commands must not become write primitives.
      "*>*": "deny",
      "git *--output*": "deny",
      "git *--ext-diff*": "deny",
      // Built-in defaults allow these readers; block secret reads.
      "cp *.env*": "deny",
      "mv *.env*": "deny",
      "cat *.env*": "deny",
      "head *.env*": "deny",
      "tail *.env*": "deny",
      "less *.env*": "deny",
      "grep *.env*": "deny",
      "rg *.env*": "deny",
      "printenv *": "deny",
      "cat *.env.example": "allow"
    },
    "nuxt-ui_get-component": {
      "*": "allow"
    },
    "laravel-boost_application-info": {
      "*": "allow"
    },
    "nuxt_get-deploy-provider": {
      "*": "allow"
    },
    "nuxt_get-documentation-page": {
      "*": "allow"
    },
    "nuxt_list-documentation-pages": {
      "*": "allow"
    },
    "read": {
      "*.env*": "deny",
      "*secrets/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.keystore": "deny",
      "*.npmrc": "deny",
      "*.netrc": "deny",
      "*id_rsa": "deny",
      "*id_ed25519": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*.env*": "deny",
      "*secrets/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.keystore": "deny",
      "*.npmrc": "deny",
      "*.netrc": "deny",
      "*id_rsa": "deny",
      "*id_ed25519": "deny",
      "*.git/*": "deny",
      "*dist/*": "deny",
      "*.lock": "deny",
      "pnpm-lock.yaml": "deny",
      "package-lock.json": "deny",
      "yarn.lock": "deny",
      "*.env.example": "allow"
    }
  },
  "indexing": {
    "provider": "kilo",
    "vectorStore": "qdrant",
    "model": "mistralai/mistral-embed-2312",
    "qdrant": {
      "url": "http://localhost:6333",
      "apiKey": "{file:~/.config/kilo/secrets/qdrant-api-key}"
    },
    "enabled": true
  },
  "small_model": "kilo/xiaomi/mimo-v2.6-pro",
  "model": "kilo/deepseek/deepseek-v4.1-flash-1017",
  "agents": {
    "orchestrator": {
      "disabled": true
    }
  },
  "default_agent": "code",
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:~/.config/kilo/secrets/github-pat}",
          "GITHUB_READ_ONLY": "1"
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless"
        ]
      },
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@6.4.0",
          "mcp"
        ],
        "environment": {
          "GHIDRA_INSTALL_DIR": "/opt/homebrew/opt/ghidra/libexec",
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
        }
      }
    }
  },
  "web_search": true,
  "reasoning_display": "preview",
  "remote_control": false,
  "hide_prompt_training_models": true,
  "retention": {
    "enabled": true,
    "maxAgeDays": 30
  }
}