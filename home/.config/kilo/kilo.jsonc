{
  "$schema": "https://app.kilo.ai/config.json",
  // The installed CLI (kilo 7.8.8, OpenCode V1) rejects the V2 "permissions" and
  // "providers" keys, and its IndexingConfig only accepts the v1 "provider" shape,
  // so those keep their V1 forms until the CLI supports V2.
  "permission": {
    "external_directory": "ask",
    "bash": {
      "sudo *": "deny",
      "chown *": "deny",
      "chmod *": "deny",
      "export *": "deny",
      "npm config *": "deny",
      "npm set *": "deny",
      "pnpm dlx *": "deny",
      "NODE_OPTIONS=* pnpm exec *": "deny",
      // Tightened commands
      "pnpm run lint *": "allow",
      "pnpm run typecheck *": "allow",
      "vendor/bin/pint *": "allow",
      "pnpm --filter *": "allow",
      // Explicit npx and php commands (Replace with your actual tools, e.g., prisma, artisan, pest)
      "npx eslint *": "allow",
      "php artisan *": "allow",
      // Safe Read-only/Informational commands
      "git diff *": "allow",
      "git status *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git show *": "allow",
      "echo *": "allow",
      "pnpm --version *": "allow",
      "pnpm exec vite*": "allow",
      "pnpm exec tsc*": "allow",
      "pnpm exec vitest*": "allow",
      "pnpm exec eslint*": "allow",
      "pnpm exec prettier*": "allow",
      "npm view [a-zA-Z0-9-_@/]*": "allow",
      "npm view [a-zA-Z0-9-_@/]* [a-zA-Z0-9.]*": "allow",
      "no-mistakes *": "allow",
      "quota-axi *": "allow",
      "kilo --version": "allow",
      "node --version": "allow",
      "bin/fm-wake-drain.sh *": "allow",
      "bin/fm-startup-network.sh *": "allow",
      "bin/fm-project-mode.sh *": "allow",
      "bin/fm-brief.sh *": "allow",
      "bin/fm-spawn.sh *": "allow",
      "bin/fm-dispatch-resolve.sh *": "allow",
      "bin/fm-bootstrap.sh *": "allow",
      "bin/fm-tasks-axi.sh *": "allow",
      "bin/fm-peek.sh *": "allow",
      "bin/fm-crew-state.sh *": "allow",
      "bin/fm-operational-input.sh *": "allow",
      "bin/fm-control.sh *": "allow",
      "bin/fm-send.sh *": "allow",
      "bin/fm-guard.sh *": "allow",
      "bin/fm-merge-local.sh *": "allow",
      "bin/fm-session-start.sh *": "allow",
      "pgrep -fl fm-watch": "allow"
    },
    "nuxt-ui_get-component": {
      "*": "allow"
    },
    "laravel-boost_application-info": {
      "*": "allow"
    },
    "nuxt_get-deploy-provider": {
      "*": "allow"
    },
    "nuxt_get-documentation-page": {
      "*": "allow"
    },
    "nuxt_list-documentation-pages": {
      "*": "allow"
    },
    "read": {
      "**/.env.example": "allow",
      ".env.example": "allow",
      "**/.env*": "deny",
      ".env*": "deny",
      "secrets/**": "deny"
    },
    "edit": {
      "**/.env.example": "allow",
      ".env.example": "allow",
      "**/.env*": "deny",
      ".env*": "deny",
      "secrets/**": "deny",
      "dist/**": "deny",
      "*.lock": "deny"
    }
  },
  "indexing": {
    "provider": "kilo",
    "vectorStore": "qdrant",
    "model": "mistralai/mistral-embed-2312",
    "qdrant": {
      "url": "http://localhost:6333",
      "apiKey": "{file:~/.config/kilo/secrets/qdrant-api-key}"
    },
    "enabled": true
  },
  "small_model": "kilo/xiaomi/mimo-v2.6-pro",
  "model": "kilo/deepseek/deepseek-v4.1-flash-1017",
  "agents": {
    "orchestrator": {
      "disabled": true
    }
  },
  "default_agent": "code",
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:~/.config/kilo/secrets/github-pat}",
          "GITHUB_READ_ONLY": "1"
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless"
        ]
      },
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@6.4.0",
          "mcp"
        ],
        "environment": {
          "GHIDRA_INSTALL_DIR": "/opt/homebrew/opt/ghidra/libexec",
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home"
        }
      }
    }
  },
  "web_search": true,
  "reasoning_display": "preview",
  "remote_control": false,
  "hide_prompt_training_models": true,
  "retention": {
    "enabled": true,
    "maxAgeDays": 30
  }
}